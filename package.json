{
  "name": "midnight-ledger",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "An illustrated field journal that reconstructs a life from 162,588 digital receipts across three anonymous archives.",
  "license": "MIT",
  "keywords": [
    "data-visualization",
    "scrollytelling",
    "data-journalism",
    "react",
    "typescript",
    "svg"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/BotBender167/midnight-ledger.git"
  },
  "scripts": {
    "data": "node scripts/build-data.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check": "vitest run src/lib/bundles.test.ts",
    "dev": "vite",
    "build": "npm run data && npm run typecheck && vite build",
    "verify": "npm run data && npm run test && npm run typecheck && npm run lint",
    "preview": "vite preview",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^9.20.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.24.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.1"
  }
}
