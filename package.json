{
  "name": "midnight-ledger",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "An illustrated field journal that reconstructs one anonymous life from 152,321 digital receipts.",
  "scripts": {
    "data": "node scripts/build-data.mjs",
    "check": "node --experimental-strip-types scripts/selfcheck.mjs",
    "dev": "vite",
    "build": "npm run data && tsc -b && vite build",
    "verify": "npm run data && npm run check && npm run typecheck && npm run lint",
    "preview": "vite preview",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.20.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^17.12.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.24.0",
    "vite": "^7.0.0"
  }
}
